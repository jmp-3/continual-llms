# =======================================================================================
# Data. None of this belongs in git, and most of it is not ours to redistribute.
# =======================================================================================

# M2D2 corpora and their source tarballs. CC BY-NC 4.0 (non-commercial) - fetch it yourself
# from https://huggingface.co/datasets/machelreid/m2d2 rather than getting it from here.
/m2d2/

# Packed uint32 token arrays derived from the above. Same license, and regenerable with
#   uv run python -m continual_llms.data.tokenize_pack
/data/

# Base model weights and tokenizer, fetched from the Hub. Never vendor these.
/models/

# Training outputs: checkpoints, ppl_matrix.jsonl, run_config.json, throughput.json.
/runs/

# Generated short-run configs and throwaway checkpoints from scripts/00_smoke.sh and
# scripts/01_bakeoff.sh. Inside the project rather than /tmp because a checkpoint is ~8 GB.
/.scratch/

# Throughput measured by scripts/00_smoke.sh; seeded into runs/<id>/throughput.json so
# scripts/02_run_cpt.sh estimates stage wall time from a real number. Machine-specific.
/.smoke_throughput.json

# Weights & Biases. WANDB_DIR defaults to $CL_ROOT, and wandb creates <WANDB_DIR>/wandb/.
# Kept out of runs/ on purpose: scripts/04_archive.sh caps a run bundle at 100 MB.
# Offline runs live here until `wandb sync` uploads them - see docs/tracking.md.
wandb/

# =======================================================================================
# Secrets and machine-specific configuration
# =======================================================================================

# Absolute paths, device selection, and anywhere a token would end up.
# Ship .env.example instead.
.env
.env.*
!.env.example

# Local uv settings (absolute cache-dir). Ship uv.toml.example instead.
# Note: a uv.toml overrides the ENTIRE [tool.uv] section of pyproject.toml.
uv.toml

# =======================================================================================
# Environments and caches
# =======================================================================================
.venv/
venv/
uv_cache/
hf_cache/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# =======================================================================================
# Local working notes, reports, and one-off scripts. Deliberately untracked.
# =======================================================================================
/REPORT*.md
/*.py
/*.sh
scratch/
notes/

# =======================================================================================
# Editors and OS
# =======================================================================================
.vscode/
.idea/
.DS_Store
*.swp
*~

# =======================================================================================
# Belt and braces: model weights and packed token arrays must never be committed from
# anywhere in the tree, whatever a future directory layout looks like.
# =======================================================================================
*.bin
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt
*.arrow
*.tar.gz
*.tar
*.zip
