# Copy to `.env` and edit. `.env` is gitignored - it holds absolute paths and is where a
# HF_TOKEN would live, so it must never be committed.
#
# Sourced by shell entry points (`set -a; source .env; set +a`) and loaded by
# `continual_llms.env.load_env()` at the top of every Python entry point, before torch is
# imported. That ordering matters: CUDA_VISIBLE_DEVICES is read once, at CUDA
# initialisation, so setting it after `import torch` is silently ineffective.

# Absolute path to this checkout. Everything else is derived from it.
CL_ROOT=/path/to/continual-llms

# Keep the HuggingFace cache off $HOME - it grows to tens of GB.
HF_HOME=${CL_ROOT}/hf_cache

# Base model. `tokenize_pack` needs only the tokenizer + config from here; training needs
# the weights (~8 GB for Qwen3-4B-Base).
#   uv run python -c "from huggingface_hub import snapshot_download as d; \
#       d('Qwen/Qwen3-4B-Base', local_dir='models/Qwen3-4B-Base')"
CL_MODEL_DIR=${CL_ROOT}/models/Qwen3-4B-Base

# Raw M2D2 domains, one directory per domain, each with train/valid/test.txt.
# CC BY-NC 4.0 - fetch it yourself from https://huggingface.co/datasets/machelreid/m2d2
CL_RAW_DIR=${CL_ROOT}/m2d2

# Derived and generated artifacts.
CL_PACKED_DIR=${CL_ROOT}/data/packed
CL_RUNS_DIR=${CL_ROOT}/runs

# Which GPUs to use, as physical device ids. They become cuda:0..cuda:N-1 in-process, and
# the count must match `num_processes` in configs/accel/*.yaml. Keep this in sync with
# CL_REQUIRED_DEVICES in scripts/_common.sh, which asserts it.
CUDA_VISIBLE_DEVICES=0,1

# VERIFY YOUR GPU PAIR BEFORE TRUSTING A RUN:
#     uv run torchrun --nproc_per_node=2 scripts/_nccl_check.py
#
# On the machine this was developed on, one GPU pair had broken peer-to-peer DMA that
# failed *silently*: NCCL set up channels `via P2P/CUMEM`, the collective timed out, and
# execution continued with untransferred data. Gradients never synchronized, the loss curve
# looked normal, and the model was garbage. `nvidia-smi topo -p2p r` reported OK for every
# pair - that is P2P capability, not proof the DMA path works.
#
# If the check fails, uncomment this. It routes collectives through host memory: correct,
# and measured at 6.6 GB/s here versus 6.3 GB/s for the pair whose P2P did work, so on a
# PCIe-only box it costs little. The training scripts re-run that check as a preflight.
# NCCL_P2P_DISABLE=1

# Optional. ZeRO-3 on a 4B model leaves only a few GB spare on a 48 GB card, and runs were
# observed stranding several GB as reserved-but-unallocated while DeepSpeed repeatedly
# flushed the allocator cache to survive. This lets segments grow in place instead.
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# The fast tokenizer is already batched-parallel inside tokenize_pack; its own thread pool
# only fights with dataloader workers.
TOKENIZERS_PARALLELISM=false

# Optional. Public repos download anonymously, just under a lower rate limit. Note that
# huggingface_hub looks for a stored token at $HF_HOME/token, so redirecting HF_HOME above
# also hides any token in ~/.cache/huggingface.
# HF_TOKEN=
